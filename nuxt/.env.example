# Port the Nuxt dev server and the built server bind to. Change it (along with
# strapi/.env's CLIENT_URL) to run alongside another LaunchPad stack.
# Defaults to 3001 rather than Nuxt's usual 3000, because LaunchPad's own
# Next.js frontend takes 3000 and people often run both.
PORT=3001

# Public URL of the site, used for canonical links and metadata.
WEBSITE_URL=http://localhost:3001

# Strapi backend URL. Read on the server for every page render, and exposed to
# the browser (via runtimeConfig.public) so media URLs resolve.
STRAPI_URL=http://localhost:1337

# Preview / draft mode secret (server only).
# Generated by `yarn setup` and written to strapi/.env too — the two MUST match
# or Strapi's preview URLs come back 401. `yarn check:env` verifies this.
PREVIEW_SECRET=preview_secret

# Session cookie secret (server only).
# Encrypts the HttpOnly cookie holding the Strapi JWT after sign-in.
# MUST be at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Rotating it invalidates every existing session cookie.
SESSION_SECRET=tobemodified
