---
import AuthMenu from '@/components/AuthMenu.astro';
import LocaleSwitcher from '@/components/LocaleSwitcher.astro';
import Logo from '@/components/Logo.astro';
import type { Global } from '@/types/strapi';

/**
 * Fixed navbar with a mobile drawer.
 *
 * The React original used framer-motion to shrink the bar on scroll and
 * Headless UI for the drawer. Here the scroll effect is a `data-scrolled`
 * attribute toggled by one listener, and the drawer is a `<details>`-free
 * button + hidden panel — about 20 lines of inline script instead of two
 * component libraries.
 */

interface Props {
  data: Global['navbar'];
  locale: string;
}

const { data, locale } = Astro.props;

const left = data?.left_navbar_items ?? [];
const right = data?.right_navbar_items ?? [];
const localePath = (url: string) => `/${locale}${url}`;
---

<nav
  id="site-navbar"
  data-scrolled="false"
  class="fixed inset-x-0 top-4 z-50 mx-auto w-[95%] max-w-7xl lg:w-full"
>
  <!-- Desktop -->
  <div
    class="mx-auto hidden w-full items-center justify-between rounded-md px-4 py-3 transition-[background-color,width] duration-300 lg:flex"
    data-navbar-shell
  >
    <div class="flex flex-row items-center gap-2">
      <Logo image={data?.logo?.image} locale={locale} />
      <div class="flex items-center gap-1.5">
        {
          left.map((item) => (
            <a
              href={localePath(item.URL)}
              target={item.target ?? undefined}
              class="flex items-center justify-center rounded-md px-4 py-2 text-sm leading-[110%] text-white transition duration-200 hover:bg-neutral-800 hover:text-white/80 hover:shadow-[0px_1px_0px_0px_var(--color-neutral-600)_inset]"
            >
              {item.text}
            </a>
          ))
        }
      </div>
    </div>

    <div class="flex items-center space-x-2">
      <LocaleSwitcher currentLocale={locale} />
      <AuthMenu locale={locale} links={right} />
    </div>
  </div>

  <!-- Mobile -->
  <div class="flex h-full w-full items-center lg:hidden">
    <div
      class="flex w-full items-center justify-between rounded-md px-2.5 py-1.5 transition duration-200"
      data-navbar-shell
    >
      <Logo image={data?.logo?.image} locale={locale} />
      <button
        type="button"
        id="mobile-menu-open"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="p-1 text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
          class="h-6 w-6"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M432 176H80c-8.8 0-16-7.2-16-16s7.2-16 16-16h352c8.8 0 16 7.2 16 16s-7.2 16-16 16zM432 272H80c-8.8 0-16-7.2-16-16s7.2-16 16-16h352c8.8 0 16 7.2 16 16s-7.2 16-16 16zM432 368H80c-8.8 0-16-7.2-16-16s7.2-16 16-16h352c8.8 0 16 7.2 16 16s-7.2 16-16 16z"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="fixed inset-0 z-50 flex flex-col items-start justify-start space-y-10 bg-black pt-5 text-xl"
  >
    <div class="flex w-full items-center justify-between px-5">
      <Logo image={data?.logo?.image} locale={locale} />
      <div class="flex items-center space-x-2">
        <LocaleSwitcher currentLocale={locale} />
        <button
          type="button"
          id="mobile-menu-close"
          aria-label="Close menu"
          class="p-1 text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
            class="h-8 w-8"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M278.6 256l68.2-68.2c6.2-6.2 6.2-16.4 0-22.6-6.2-6.2-16.4-6.2-22.6 0L256 233.4l-68.2-68.2c-6.2-6.2-16.4-6.2-22.6 0-3.1 3.1-4.7 7.2-4.7 11.3 0 4.1 1.6 8.2 4.7 11.3l68.2 68.2-68.2 68.2c-3.1 3.1-4.7 7.2-4.7 11.3 0 4.1 1.6 8.2 4.7 11.3 6.2 6.2 16.4 6.2 22.6 0l68.2-68.2 68.2 68.2c6.2 6.2 16.4 6.2 22.6 0 6.2-6.2 6.2-16.4 0-22.6L278.6 256z"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="flex flex-col items-start justify-start gap-[14px] px-8">
      {
        left.map((item) =>
          item.children?.length ? (
            item.children.map((child) => (
              <a
                href={localePath(child.URL)}
                class="max-w-[15rem] text-left text-2xl"
              >
                <span class="block text-white">{child.text}</span>
              </a>
            ))
          ) : (
            <a href={localePath(item.URL)}>
              <span class="block text-[26px] text-white">{item.text}</span>
            </a>
          )
        )
      }
    </div>

    <div class="flex w-full flex-row items-start gap-2.5 px-8 py-4">
      <AuthMenu locale={locale} links={right} />
    </div>
  </div>
</nav>

<style>
  /* Replaces framer-motion's animated width/background on scroll. */
  [data-navbar-shell] {
    background-color: transparent;
    width: 100%;
  }
  #site-navbar[data-scrolled='true'] [data-navbar-shell] {
    background-color: rgb(23 23 23);
    box-shadow:
      0px -2px 0px 0px var(--color-neutral-800),
      0px 2px 0px 0px var(--color-neutral-800);
  }
  @media (min-width: 1024px) {
    #site-navbar[data-scrolled='true'] [data-navbar-shell] {
      width: 80%;
      border-radius: 0.375rem;
    }
  }
</style>

<script>
  const navbar = document.getElementById('site-navbar');
  const menu = document.getElementById('mobile-menu');
  const openButton = document.getElementById('mobile-menu-open');
  const closeButton = document.getElementById('mobile-menu-close');

  if (navbar) {
    // Passive listener: this only reads scrollY, never calls preventDefault.
    const onScroll = () => {
      navbar.dataset.scrolled = window.scrollY > 100 ? 'true' : 'false';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setMenu = (open: boolean) => {
    if (!menu) return;
    menu.hidden = !open;
    openButton?.setAttribute('aria-expanded', String(open));
    // Stop the page scrolling behind the drawer.
    document.body.style.overflow = open ? 'hidden' : '';
  };

  openButton?.addEventListener('click', () => setMenu(true));
  closeButton?.addEventListener('click', () => setMenu(false));
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
</script>
