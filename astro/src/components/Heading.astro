---
interface Props {
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}
const { class: className = '', as: Tag = 'h2' } = Astro.props;
---

<Tag
  class:list={[
    'text-secondary bg-gradient-to-b from-white to-neutral-400 bg-clip-text text-center text-2xl font-semibold tracking-tight text-transparent md:text-4xl md:leading-tight',
    className,
  ]}
>
  <slot />
</Tag>
