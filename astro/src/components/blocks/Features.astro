---
import Container from '@/components/Container.astro';
import Heading from '@/components/Heading.astro';
import Subheading from '@/components/Subheading.astro';
import { FeaturesGrid } from '@/components/react/FeaturesGrid';

interface FeatureCard {
  title?: string | null;
  description?: string | null;
  span?: string | null;
}

interface Props {
  heading?: string;
  sub_heading?: string;
  globe_card?: FeatureCard;
  ray_card?: FeatureCard;
  graph_card?: FeatureCard;
  social_media_card?: FeatureCard;
}
const {
  heading,
  sub_heading,
  globe_card,
  ray_card,
  graph_card,
  social_media_card,
} = Astro.props;
---

<div class="relative py-20">
  <Container>
    <Heading data-reveal>{heading}</Heading>
    {
      sub_heading && (
        <Subheading class="mt-4" data-reveal>
          {sub_heading}
        </Subheading>
      )
    }

    <FeaturesGrid
      client:only="react"
      globe_card={globe_card}
      ray_card={ray_card}
      graph_card={graph_card}
      social_media_card={social_media_card}
    />
  </Container>
</div>
