---
import type { BlockNode } from '@/types/strapi';

/**
 * A leaf text node with its inline marks.
 *
 * Strapi applies marks as independent booleans on the same node, so they nest
 * rather than being mutually exclusive: bold + italic + code is one node with
 * three flags. Astro has no runtime element composition, so the combinations
 * are expressed by wrapping from the inside out.
 */

interface Props {
  node: BlockNode;
}

const { node } = Astro.props;
const text = node.text ?? '';
---

{
  node.code ? (
    <code class="rounded bg-neutral-800 px-1.5 py-0.5 font-mono text-[0.9em] text-neutral-200">
      {text}
    </code>
  ) : (
    <Fragment>
      {node.bold && node.italic && (
        <strong>
          <em>{text}</em>
        </strong>
      )}
      {node.bold && !node.italic && <strong>{text}</strong>}
      {!node.bold && node.italic && <em>{text}</em>}
      {!node.bold && !node.italic && node.underline && <u>{text}</u>}
      {!node.bold && !node.italic && !node.underline && node.strikethrough && (
        <s>{text}</s>
      )}
      {!node.bold &&
        !node.italic &&
        !node.underline &&
        !node.strikethrough &&
        text}
    </Fragment>
  )
}
