---
/*
 * Shown only when the draft cookie is set. Hidden inside the Strapi preview
 * iframe, where the admin already provides its own controls and a second
 * banner would just cover content.
 */
---

<div
  id="draft-mode-banner"
  class="bg-secondary fixed right-4 bottom-4 z-50 hidden items-center gap-4 rounded-lg px-6 py-3 text-black shadow-lg"
>
  <span class="flex items-center gap-2 font-semibold">
    <span class="inline-block h-4 w-4 animate-pulse rounded-full bg-black"
    ></span>
    Draft Mode
  </span>
  <a
    href="/api/exit-preview"
    class="rounded bg-black px-4 py-1 text-sm font-medium text-white transition-colors hover:bg-gray-800"
  >
    Exit Draft
  </a>
</div>

<script>
  // Only reveal outside an iframe; `window.top === window` means top-level.
  const banner = document.getElementById('draft-mode-banner');
  if (banner && window.top === window.self) {
    banner.classList.remove('hidden');
    banner.classList.add('flex');
  }
</script>
